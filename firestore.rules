rules_version = '2';
// A&L 運営マニュアル Maker 用ルール
//  ・ログインできるのは @alonzo.jp の Google アカウントだけ
//  ・全員が閲覧できる／自分で作ったデータは本人が更新できる／削除はオーナーだけ
service cloud.firestore {
  match /databases/{db}/documents {
    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true
        && request.auth.token.email.matches('.*@alonzo[.]jp$');
    }
    function me() { return request.auth.token.email; }
    function rolesDoc() { return /databases/$(db)/documents/config/roles; }
    function isOwner() {
      return signedIn() && (me() == 'airi_ishida@alonzo.jp'
        || (exists(rolesDoc()) && me() in get(rolesDoc()).data.owners));
    }
    function metaPath(id) { return /databases/$(db)/documents/lib/$(id); }

    // メンバー（招待リスト・オーナー）
    match /config/{d} {
      allow read: if signedIn();
      allow write: if isOwner();
    }
    // ログインの記録（オーナーだけが見られる）
    match /logins/{d} {
      allow create: if signedIn() && request.resource.data.email == me();
      allow read, delete: if isOwner();
    }
    // 作業データの一覧情報
    match /lib/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.createdBy == me();
      allow update: if signedIn() && (isOwner() || resource.data.createdBy == me())
        && request.resource.data.createdBy == resource.data.createdBy;
      allow delete: if isOwner();
    }
    // 作業データの本文（800KBごとに分割。ID は「一覧のID__番号」）
    match /libBody/{pid} {
      allow read: if signedIn();
      allow write: if signedIn() && (isOwner()
        || !exists(metaPath(pid.split('__')[0]))
        || get(metaPath(pid.split('__')[0])).data.createdBy == me());
    }
    // 画像（内容から決まるIDで1枚ずつ。上書きはしない）
    match /img/{h} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.d is string;
      allow delete: if isOwner();
    }
  }
}
